/* Shared by the catch panel and the settings screen. */

body {
    font-family: Roboto;
}

/* Text placed by its top-left corner, one line, the way the panel was laid out. */
.text {
    position: absolute;
    white-space: nowrap;
    font-kerning: none;
}

/* Everything inside a panel is placed absolutely; a layer is a group that shows and hides together. */
.layer {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

.layer > div, .layer > img, .layer > polygon {
    position: absolute;
}


/* The design's fonts, beside the documents (licences in fonts/). Roboto Regular is the
   Runtime's own. */
@font-face { font-family: Jost; font-weight: 400; src: "fonts/Jost-Regular.ttf"; }
@font-face { font-family: Jost; font-weight: 500; src: "fonts/Jost-Medium.ttf"; }
@font-face { font-family: Roboto; font-weight: 500; src: "fonts/Roboto-Medium.ttf"; }
@font-face { font-family: Roboto; font-weight: 500; font-style: italic; src: "fonts/Roboto-MediumItalic.ttf"; }
